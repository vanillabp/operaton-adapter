<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the workflows of this repository give Maven.

  One server, which reads its credentials from environment variables that only the steps
  which need them set: 'vanillabp-central' is the server of the profile 'central-portal' in
  io.vanillabp:release-parent. A push to main publishes the snapshots with it.

  Everything else comes from Maven Central and its snapshot repository, which need no login.
  That includes the Camunda 7 adapter, which the module migration-tests runs next to this one.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>vanillabp-central</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
        </server>
    </servers>
</settings>
