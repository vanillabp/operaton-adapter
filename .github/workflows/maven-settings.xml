<?xml version="1.0" encoding="UTF-8"?>
<!--
  What the workflows of this repository give Maven.

  Two servers, and both read their credentials from environment variables, which only the
  steps that need them set:

  - 'vanillabp-central' is the server of the profile 'central-portal' in
    io.vanillabp:release-parent. A push to main publishes the snapshots with it.
  - 'camunda-community-hub-vanillabp-camunda7-adapter' is the GitHub Packages registry of the
    Camunda 7 adapter. The module migration-tests runs that adapter next to this one, and its
    snapshots are only there. GitHub Packages wants a login even for a public package, so
    the token needs 'read:packages'. This goes away once the Camunda 7 adapter has a release
    on Maven Central.

  Everything else comes from Maven Central and its snapshot repository, which need no login.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
    <servers>
        <server>
            <id>vanillabp-central</id>
            <username>${env.MAVEN_USERNAME}</username>
            <password>${env.MAVEN_PASSWORD}</password>
        </server>
        <server>
            <id>camunda-community-hub-vanillabp-camunda7-adapter</id>
            <username>${env.USER_NAME}</username>
            <password>${env.USER_TOKEN}</password>
        </server>
    </servers>
</settings>
